# Copy to .env and adjust.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL="postgresql://sankofa:sankofa@localhost:5432/sankofa?schema=public"

# Redis for BullMQ background jobs. Leave unset to run the API without jobs.
# REDIS_URL="redis://localhost:6379"

# ---------------------------------------------------------------------------
# Auth
#   AUTH_MODE=dev   -> trusts an `x-user-id` header (LOCAL ONLY; the app refuses
#                      to boot if NODE_ENV=production). Defaults to dev when
#                      NODE_ENV is not production.
#   AUTH_MODE=oidc  -> verifies a Bearer JWT against the provider's JWKS.
#                      Defaults to oidc in production. Works with any OIDC
#                      provider (Clerk / Auth0 / Cognito).
# ---------------------------------------------------------------------------
AUTH_MODE=dev

# Required when AUTH_MODE=oidc:
# OIDC_ISSUER="https://your-tenant.clerk.accounts.dev"
# OIDC_JWKS_URI defaults to ${OIDC_ISSUER}/.well-known/jwks.json — override if different:
# OIDC_JWKS_URI="https://your-tenant.clerk.accounts.dev/.well-known/jwks.json"
# OIDC_AUDIENCE is optional; enforced only when set:
# OIDC_AUDIENCE="sankofa-api"
